{
  "productName": "迷你互传助手",
  "version": "1.0.0",
  "identifier": "com.mini-transfer.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "迷你互传助手 v1.0.0",
        "width": 560,
        "height": 612,
        "resizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  },
  "plugins": {
    "shell": {
      "open": "((mailto|tel|https?|file):\\/\\/|[A-Za-z]:\\\\|\\\\\\\\|\\/).+"
    }
  }
}
